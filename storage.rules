rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function activeAdmin(shopId) {
      return signedIn() && request.auth.token.active == true
        && request.auth.token.role == 'ADMIN' && request.auth.token.shopId == shopId;
    }
    function activeStaff(shopId, permission) {
      return signedIn() && request.auth.token.active == true
        && request.auth.token.role == 'STAFF' && request.auth.token.shopId == shopId
        && request.auth.token.permissions is list && request.auth.token.permissions.hasAny([permission]);
    }
    function canManageCatalog(shopId) {
      return activeAdmin(shopId) || activeStaff(shopId, 'MANAGE_PRODUCTS');
    }
    function imageUnder(maxBytes) {
      return request.resource.size > 0 && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /shops/{shopId}/categories/uploads/{fileName} {
      allow create: if canManageCatalog(shopId) && imageUnder(5 * 1024 * 1024);
      allow read, update, delete: if false;
    }
    match /shops/{shopId}/subcategories/uploads/{fileName} {
      allow create: if canManageCatalog(shopId) && imageUnder(5 * 1024 * 1024);
      allow read, update, delete: if false;
    }
    match /shops/{shopId}/products/uploads/{fileName} {
      allow create: if canManageCatalog(shopId) && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow read, update, delete: if false;
    }
    match /shops/{shopId}/banners/uploads/{fileName} {
      allow create: if activeAdmin(shopId) && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow read, update, delete: if false;
    }
    match /shops/{shopId}/categories/{categoryId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /shops/{shopId}/subcategories/{subcategoryId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /shops/{shopId}/products/{productId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /shops/{shopId}/banners/{bannerId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /users/{userId}/profile/{fileName} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId && imageUnder(2 * 1024 * 1024);
      allow delete: if signedIn() && request.auth.uid == userId;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
