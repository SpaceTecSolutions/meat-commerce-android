    <string name="legal_heading_about_meat_station_c6f8180">About Meat Station</string>
    <string name="legal_body_meat_station_provides_fresh_meat_0f07250">Meat Station provides fresh meat ordering through this mobile app and its public website, meatstation.org. Product availability, prices, delivery areas, and checkout terms shown in the app apply to mobile orders.</string>
    <string name="legal_heading_customer_account_2cb87ac">Customer Account</string>
    <string name="legal_body_keep_your_name_mobile_number_043a1da">Keep your name, mobile number, and delivery details accurate. Access to your account is protected by the sign-in method provided in the app.</string>
    <string name="legal_heading_product_information_8f093e6">Product Information</string>
    <string name="legal_body_product_descriptions_units_and_pric_6a7ed3f">Product descriptions, units, and prices are displayed before you add items to your cart. Availability may change before an order is confirmed.</string>
    <string name="legal_heading_pricing_a0d9bba">Pricing</string>
    <string name="legal_body_the_checkout_review_shows_item_f0829a6">The checkout review shows item prices, any delivery charge, and the total payable before confirmation.</string>
    <string name="legal_heading_order_progress_917954c">Order Progress</string>
    <string name="legal_body_order_status_may_move_from_5faa237">Order status may move from Placed to Confirmed, Preparing, Out for Delivery, and Delivered, or to Cancelled when cancellation is permitted.</string>
    <string name="legal_heading_scheduled_delivery_0961476">Scheduled Delivery</string>
    <string name="legal_body_select_an_available_delivery_date_7358526">Select an available delivery date and time slot at checkout. The slot is an expected delivery window, not an exact-minute guarantee.</string>
    <string name="legal_heading_delivery_address_1f63936">Delivery Address</string>
    <string name="legal_body_provide_a_correct_address_location_9414316">Provide a correct address, location pin, contact number, and any access instructions needed to complete delivery.</string>
    <string name="legal_heading_receiving_perishable_goods_d011ef8">Receiving Perishable Goods</string>
    <string name="legal_body_please_check_the_delivered_package_c4414df">Please check the delivered package promptly and contact support if there is an issue with your order.</string>
    <string name="legal_heading_payments_44357ae">Payments</string>
    <string name="legal_body_available_methods_may_include_cash_9fd8210">Available methods may include Cash on Delivery and a configured online payment provider. The final amount and selected method are shown before confirmation. Online orders are created only after verified payment.</string>
    <string name="legal_heading_cancellation_319aaae">Cancellation</string>
    <string name="legal_body_an_order_may_be_cancelled_7a681df">An order may be cancelled from Order Details only while the app offers that action. Once preparation or delivery begins, cancellation may no longer be available.</string>
    <string name="legal_heading_problems_with_an_order_73b3166">Problems with an Order</string>
    <string name="legal_body_fresh_products_need_prompt_review_115ab07">Fresh products need prompt review. Contact Customer Support about missing, damaged, or incorrect items so the shop can review the issue and available resolution.</string>
    <string name="legal_heading_personal_information_ad12e42">Personal Information</string>
    <string name="legal_body_account_delivery_and_order_informat_7375e35">Account, delivery, and order information is handled as described in the Privacy Policy. You can request account deletion from Profile Information.</string>
    <string name="legal_heading_changes_8aa57de">Changes</string>
    <string name="legal_body_these_terms_may_be_updated_77a9712">These terms may be updated when the service changes. The version and last-updated date shown here identify this published text.</string>
    <string name="legal_heading_account_profile_8a259c8">Account &amp; Profile</string>
    <string name="legal_body_we_use_your_name_mobile_f07ccb3">We use your name, mobile number, sign-in information, and account status to provide your customer account and contact you about orders.</string>
    <string name="legal_heading_delivery_addresses_location_pin_38fa88c">Delivery Addresses &amp; Location Pin</string>
    <string name="legal_body_saved_addresses_may_include_recipie_98dd63f">Saved addresses may include recipient details, landmarks, and a selected map pin. The pin identifies a delivery destination; this screen does not require continuous or background customer location tracking.</string>
    <string name="legal_heading_orders_fulfilment_7e8beae">Orders &amp; Fulfilment</string>
    <string name="legal_body_order_records_include_items_quantit_d91dd55">Order records include items, quantities, prices, totals, selected delivery slots, instructions, and progress status.</string>
    <string name="legal_body_we_record_the_selected_payment_678669e">We record the selected payment method, provider references where applicable, amount due, and payment status. Sensitive card or UPI credentials are handled by the payment provider and are not stored by this app.</string>
    <string name="legal_heading_notifications_devices_dc9cead">Notifications &amp; Devices</string>
    <string name="legal_body_push_tokens_and_recent_in_db23eb1">Push tokens and recent in-app notices support account and order alerts.</string>
    <string name="legal_heading_prepare_deliver_orders_bbeb192">Prepare &amp; Deliver Orders</string>
    <string name="legal_body_the_shop_uses_order_and_dfccbd1">The shop uses order and address details to prepare products and deliver them in the selected slot.</string>
    <string name="legal_heading_service_updates_support_c57e68d">Service Updates &amp; Support</string>
    <string name="legal_body_we_use_relevant_contact_and_a5624f7">We use relevant contact and order details to send operational notices and respond to support requests.</string>
    <string name="legal_heading_account_safety_a78e74b">Account Safety</string>
    <string name="legal_body_authentication_and_device_informati_7a04ea4">Authentication and device information helps protect accounts and prevent misuse.</string>
    <string name="legal_heading_service_infrastructure_372a603">Service Infrastructure</string>
    <string name="legal_body_the_app_uses_its_configured_4fc1a9d">The app uses its configured cloud, notification, and mapping providers to operate these services.</string>
    <string name="legal_heading_fulfilment_personnel_7a4ad36">Fulfilment Personnel</string>
    <string name="legal_body_assigned_staff_receive_the_order_2d31d29">Assigned staff receive the order and recipient details needed to prepare and deliver an active order.</string>
    <string name="legal_heading_protection_0f8cc4f">Protection</string>
    <string name="legal_body_access_to_customer_records_is_0620f1c">Access to customer records is restricted by account and role permissions, and app traffic uses encrypted connections.</string>
    <string name="legal_heading_account_deletion_18b90b6">Account Deletion</string>
    <string name="legal_body_after_active_orders_are_completed_148c3dc">After active orders are completed or cancelled, you can delete your account in the app. The account profile, saved addresses, cart, notifications, device registrations, and sign-in identity are removed.</string>
    <string name="legal_heading_historical_business_records_25682cb">Historical Business Records</string>
    <string name="legal_body_past_order_and_payment_facts_df14f11">Past order and payment facts may be retained without your name, contact details, address, or account identifier for accounting, legal, security, or fraud-prevention purposes.</string>
    <string name="legal_heading_your_controls_e33870a">Your Controls</string>
    <string name="legal_body_profile_information_lets_you_update_935e004">Profile Information lets you update your name and request deletion. Saved addresses and notifications can be managed in their respective screens.</string>
    <string name="legal_heading_updates_c76d180">Updates</string>
    <string name="legal_body_the_version_and_last_updated_48cfe3b">The version and last-updated date on this page identify this policy text. Changes to data practices require an updated policy.</string>
    <string name="legal_heading_questions_9a1fc17">Questions</string>
    <string name="legal_body_contact_customer_support_from_your_a75603c">Contact Customer Support from your Profile &amp; Account screen for privacy questions.</string>
</resources>
